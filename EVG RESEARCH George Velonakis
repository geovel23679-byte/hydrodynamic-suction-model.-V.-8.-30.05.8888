# ================================================================
# 5. SIMPLIFIED STABILITY DEGRADATION
# ================================================================

def calculate_stability_scenario(
    rng,
    config
):

    gm_initial = rng.uniform(
        *config.gm_initial_range
    )

    gm_critical = rng.uniform(
        *config.gm_critical_range
    )

    gm_loss_rate = rng.uniform(
        *config.gm_loss_rate_range
    )

    flooding_rate = rng.uniform(
        *config.flooding_rate_range
    )

    initial_heel = rng.uniform(
        *config.heel_initial_range
    )

    # Simplified linear GM degradation proxy.
    # This is NOT a physical flooding or stability solver.

    if gm_initial <= gm_critical:

        ttc = config.ttc_minimum

    elif gm_loss_rate > 0:

        ttc = (
            gm_initial - gm_critical
        ) / gm_loss_rate

    else:

        ttc = float("inf")

    ttc = max(
        config.ttc_minimum,
        ttc
    )

    return {
        "gm_initial": gm_initial,
        "gm_critical": gm_critical,
        "gm_loss_rate": gm_loss_rate,
        "flooding_rate": flooding_rate,
        "initial_heel": initial_heel,
        "ttc": ttc
    }


