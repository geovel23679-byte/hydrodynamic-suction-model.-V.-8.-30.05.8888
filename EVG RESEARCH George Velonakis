def validate_config(config):

    if config.simulations < 1:
        raise ValueError("Simulation count must be positive.")

    if config.ship_length_m <= 0:
        raise ValueError("Ship length must be positive.")

    if config.seawater_density <= 0:
        raise ValueError("Water density must be positive.")

    if config.gravity <= 0:
        raise ValueError("Gravity must be positive.")

    if config.safety_reserve_s < 0:
        raise ValueError("Safety reserve cannot be negative.")

    ranges = [
        config.gm_initial_range,
        config.gm_critical_range,
        config.gm_loss_rate_range,
        config.flooding_rate_range,
        config.heel_initial_range,
        config.distance_range,
        config.escape_speed_range,
        config.response_delay_range,
        config.stern_current_range,
    ]

    for low, high in ranges:

        if low < 0 or high < low:
            raise ValueError("Invalid parameter range.")

    if config.escape_speed_range[0] <= 0:
        raise ValueError("Escape speed must be positive.")


