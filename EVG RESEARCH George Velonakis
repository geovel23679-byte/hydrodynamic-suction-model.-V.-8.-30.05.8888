# ================================================================
# 7. LIFEBOAT SCENARIO
# ================================================================

def calculate_lifeboat_scenario(
    rng,
    config
):

    distance = rng.uniform(
        *config.distance_range
    )

    escape_speed = rng.uniform(
        *config.escape_speed_range
    )

    response_delay = rng.uniform(
        *config.response_delay_range
    )

    stern_current = rng.uniform(
        *config.stern_current_range
    )

    return {
        "distance": distance,
        "escape_speed": escape_speed,
        "response_delay": response_delay,
        "stern_current": stern_current
    }


# ================================================================
# 8. CONCEPTUAL STERN INTERACTION
# ================================================================

def calculate_relative_motion(
    escape_speed,
    stern_current
):

    # One-dimensional conceptual screening only.
    # Does not calculate real stern flow, vortices or suction.

    effective_speed = (
        escape_speed - stern_current
    )

    return effective_speed


# ================================================================
# 9. TEMPORAL SURVIVAL WINDOW
# ================================================================

def calculate_temporal_window(
    ttc,
    distance,
    effective_speed,
    response_delay,
    safety_reserve
):

    if effective_speed <= 0:

        tte = float("inf")

        ts = float("-inf")

        state = "NO_POSITIVE_CLEARANCE_SPEED"

    else:

        tte = (
            response_delay
            + distance / effective_speed
        )

        ts = (
            ttc
            - tte
            - safety_reserve
        )

        if ts > 0:

            state = "POSITIVE"

        elif ts < 0:

            state = "NEGATIVE"

        else:

            state = "ZERO_MARGIN"

    return tte, ts, state


# ================================================================
# 10. SINGLE EVG SCENARIO
# ================================================================

def run_single_scenario(
    rng,
    index,
    config
):

    stability = calculate_stability_scenario(
        rng,
        config
    )

    ship_motion = calculate_ship_motion(
        rng,
        config
    )

    lifeboat = calculate_lifeboat_scenario(
        rng,
        config
    )

    effective_speed = calculate_relative_motion(
        lifeboat["escape_speed"],
        lifeboat["stern_current"]
    )

    tte, ts, state = calculate_temporal_window(

        stability["ttc"],

        lifeboat["distance"],

        effective_speed,

        lifeboat["response_delay"],

        config.safety_reserve_s
    )

    return EVGResult(

        scenario=index,

        initial_GM_m=stability["gm_initial"],

        critical_GM_m=stability["gm_critical"],

        GM_loss_rate_m_s=stability["gm_loss_rate"],

        flooding_rate_m3_min=stability["flooding_rate"],

        initial_heel_deg=stability["initial_heel"],

        TTC_s=stability["ttc"],

        distance_m=lifeboat["distance"],

        escape_speed_m_s=lifeboat["escape_speed"],

        stern_current_m_s=lifeboat["stern_current"],

        response_delay_s=lifeboat["response_delay"],

        effective_speed_m_s=effective_speed,

        TTE_s=tte,

        safety_reserve_s=config.safety_reserve_s,

        TS_s=ts,

        time_state=state,

        stability_warning=True
    )


# ================================================================
# 11. MONTE CARLO ENGINE
# ================================================================

def run_monte_carlo(config):

    rng = random.Random(
        config.seed
    )

    results = []

    for index in range(
        1,
        config.simulations + 1
    ):

        result = run_single_scenario(
            rng,
            index,
            config
        )

        results.append(result)

    return results


# ================================================================
# 12. STATISTICAL FUNCTIONS
# ================================================================

def percentile(values, p):

    if not values:

        return float("nan")

    ordered = sorted(values)

    position = (
        (len(ordered) - 1)
        * p / 100.0
    )

    lower = int(position)

    upper = min(
        lower + 1,
        len(ordered) - 1
    )

    fraction = position - lower

    return (
        ordered[lower] * (1 - fraction)
        + ordered[upper] * fraction
    )


# ================================================================
# 13. RESULT ANALYSIS
# ================================================================

def analyze_results(results):

    total = len(results)

    positive = [
        r for r in results
        if r.TS_s > 0
    ]

    negative = [
        r for r in results
        if r.TS_s < 0
    ]

    nonfinite = [
        r for r in results
        if not math.isfinite(r.TS_s)
    ]

    finite = [
        r for r in results
        if math.isfinite(r.TS_s)
    ]

    ts_values = [
        r.TS_s for r in finite
    ]

    ttc_values = [
        r.TTC_s for r in results
        if math.isfinite(r.TTC_s)
    ]

    tte_values = [
        r.TTE_s for r in results
        if math.isfinite(r.TTE_s)
    ]

    stats = {

        "simulations": total,

        "positive_count": len(positive),

        "negative_count": len(negative),

        "nonfinite_count": len(nonfinite),

        "positive_fraction": (
            len(positive) / total
        ),

        "negative_fraction": (
            len(negative) / total
        ),

        "median_TTC": (
            statistics.median(ttc_values)
            if ttc_values else None
        ),

        "median_TTE": (
            statistics.median(tte_values)
            if tte_values else None
        ),

        "median_TS": (
            statistics.median(ts_values)
            if ts_values else None
        ),

        "mean_TS": (
            statistics.mean(ts_values)
            if ts_values else None
        ),

        "std_TS": (
            statistics.stdev(ts_values)
            if len(ts_values) > 1 else 0
        ),

        "p05_TS": percentile(ts_values, 5),

        "p50_TS": percentile(ts_values, 50),

        "p95_TS": percentile(ts_values, 95),

    }

    return stats


# ================================================================
# 14. SENSITIVITY SCREENING
# ================================================================

def calculate_sensitivity(results):

    variables = [

        "initial_GM_m",

        "GM_loss_rate_m_s",

        "flooding_rate_m3_min",

        "initial_heel_deg",

        "stern_current_m_s",

        "distance_m",

        "escape_speed_m_s",

        "response_delay_s"

    ]

    finite_results = [
        r for r in results
        if math.isfinite(r.TS_s)
    ]

    if len(finite_results) < 3:

        return {}

    ts = [
        r.TS_s for r in finite_results
    ]

    mean_ts = statistics.mean(ts)

    sensitivity = {}

    for variable in variables:

        values = [
            getattr(r, variable)
            for r in finite_results
        ]

        mean_x = statistics.mean(values)

        numerator = sum(
            (x - mean_x) * (y - mean_ts)
            for x, y in zip(values, ts)
        )

        denominator_x = math.sqrt(
            sum(
                (x - mean_x) ** 2
                for x in values
            )
        )

        denominator_y = math.sqrt(
            sum(
                (y - mean_ts) ** 2
                for y in ts
            )
        )

        if denominator_x == 0 or denominator_y == 0:

            correlation = 0.0

        else:

            correlation = (
                numerator
                / (denominator_x * denominator_y)
            )

        sensitivity[variable] = correlation

    return sensitivity


